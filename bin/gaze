#!/usr/bin/env bash
# gaze - drive a persistent, visible browser that reuses your real logins.
#
# The automation profile is a CLONE of your everyday profile, because Chrome 136+
# refuses remote debugging on a browser's default data directory. Chromium-family
# browsers are driven over CDP; Firefox-family over WebDriver BiDi, which is what
# Firefox serves now that CDP was removed in 141.
set -uo pipefail

# Resolve the component root from this script's real location, so the repo can be
# checked out anywhere and ~/.local/bin/gaze can be a symlink to it.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
D="${GAZE_HOME:-$(cd "$(dirname "$SELF")/.." && pwd)}"

export DISPLAY="${DISPLAY:-:1}"
PORT="${GAZE_PORT:-9225}"
export GAZE_PORT="$PORT"

# ---------------------------------------------------------------- browsers ----
# name|binary|everyday profile|clone dir|family
# Snap builds can only read profiles under ~/snap/<pkg>/, so their clone must
# live there too. Everything else clones into ~/.local/share/gaze/profiles.
CLONES="$HOME/.local/share/gaze/profiles"
FF="$HOME/.mozilla/firefox"

# Browser locations differ per OS, so the table is chosen per OS rather than
# guessed. Windows is NOT supported: this is a bash launcher that also assumes
# POSIX paths, and the biometric approval path is Linux-only. Under WSL it works
# as Linux.
case "$(uname -s)" in
  Darwin)
    APP="/Applications"
    SUP="$HOME/Library/Application Support"
    CLONES="$HOME/Library/Application Support/gaze/profiles"
    FF="$SUP/Firefox/Profiles"
    BROWSERS="
brave|$APP/Brave Browser.app/Contents/MacOS/Brave Browser|$SUP/BraveSoftware/Brave-Browser|$CLONES/brave|chromium
chrome|$APP/Google Chrome.app/Contents/MacOS/Google Chrome|$SUP/Google/Chrome|$CLONES/chrome|chromium
chromium|$APP/Chromium.app/Contents/MacOS/Chromium|$SUP/Chromium|$CLONES/chromium|chromium
edge|$APP/Microsoft Edge.app/Contents/MacOS/Microsoft Edge|$SUP/Microsoft Edge|$CLONES/edge|chromium
vivaldi|$APP/Vivaldi.app/Contents/MacOS/Vivaldi|$SUP/Vivaldi|$CLONES/vivaldi|chromium
firefox|$APP/Firefox.app/Contents/MacOS/firefox|$SUP/Firefox/PROFILES_INI|$CLONES/firefox|firefox
"
    ;;
  *)
    # Snap builds can only read profiles under ~/snap/<pkg>/, so their clone must
    # live there too. Everything else clones into ~/.local/share/gaze/profiles.
    BROWSERS="
brave-snap|/snap/bin/brave|$HOME/snap/brave/current/.config/BraveSoftware/Brave-Browser|$HOME/snap/brave/current/.config/BraveSoftware/gaze-auth|chromium
brave|/usr/bin/brave-browser|$HOME/.config/BraveSoftware/Brave-Browser|$CLONES/brave|chromium
chrome|/usr/bin/google-chrome|$HOME/.config/google-chrome|$CLONES/chrome|chromium
chromium|/usr/bin/chromium|$HOME/.config/chromium|$CLONES/chromium|chromium
chromium-snap|/snap/bin/chromium|$HOME/snap/chromium/common/chromium|$HOME/snap/chromium/common/gaze-auth|chromium
edge|/usr/bin/microsoft-edge|$HOME/.config/microsoft-edge|$CLONES/edge|chromium
vivaldi|/usr/bin/vivaldi|$HOME/.config/vivaldi|$CLONES/vivaldi|chromium
opera|/usr/bin/opera|$HOME/.config/opera|$CLONES/opera|chromium
basilisk|$HOME/.local/opt/firefox-devedition/firefox|$FF/basilisk-dev|$CLONES/basilisk|firefox
firefox|/usr/bin/firefox|$FF/PROFILES_INI|$CLONES/firefox|firefox
firefox-snap|/snap/bin/firefox|$HOME/snap/firefox/common/.mozilla/firefox/PROFILES_INI|$HOME/snap/firefox/common/gaze-auth|firefox
"
    ;;
esac

# Firefox keeps its profiles in named directories listed in profiles.ini, so the
# "everyday profile" has to be looked up rather than hardcoded.
resolve_ini(){
  local root="${1%/PROFILES_INI}" ini="${1%/PROFILES_INI}/profiles.ini" p
  [ -f "$ini" ] || { echo "$root/__missing__"; return; }
  p=$(awk -F= '/^\[/{d=0} /^Default=1/{d=1} /^Path=/{if(d){print $2; exit}}' "$ini")
  [ -z "$p" ] && p=$(awk -F= '/^Path=.*default-release/{print $2; exit}' "$ini")
  [ -z "$p" ] && p=$(awk -F= '/^Path=/{print $2; exit}' "$ini")
  case "$p" in /*) echo "$p" ;; *) echo "$root/$p" ;; esac
}

row_for(){ echo "$BROWSERS" | grep "^$1|" | head -1; }

# GAZE_PROFILE is operator-supplied and reaches `rm -rf`. Check the RESOLVED
# path, never the literal string: "$CLONES/../../.." matches a glob on $CLONES
# while actually pointing at $HOME, so a lexical guard lets the worst case
# straight through. Prints the resolved path; used by both `sync` and `start`.
assert_clone(){
  local raw="$1" real
  # Resolution has to be portable: macOS ships BSD readlink, which has no -m
  # (and no --), so `readlink -m` fails on every macOS path and the guard would
  # refuse everything. node is already a hard dependency, and it gives us both
  # halves: lexical .. normalisation always, plus symlink resolution when the
  # path exists (a first sync names a directory that does not exist yet).
  real=$(node -e '
    const p = require("path"), f = require("fs");
    let x = p.resolve(process.argv[1]);
    try { x = f.realpathSync(x); } catch {}
    process.stdout.write(x);
  ' "$raw" 2>/dev/null)
  [ -n "$real" ] || { echo "cannot resolve profile path '$raw'" >&2; exit 1; }
  case "$real" in
    "$HOME"|/|/home|/root|/etc|/usr|/var)
      echo "refusing to touch '$real'." >&2; exit 1 ;;
  esac
  # Anchored to the roots gaze actually clones into. A bare */gaze-auth match
  # would accept /tmp/gaze-auth or /etc/gaze-auth -- directories that have
  # nothing to do with this tool but would still be handed to `rm -rf`.
  # In a `case` glob, * spans slashes, so the deep snap paths match.
  case "$real" in
    "$CLONES"/?*)                ;;
    "$HOME"/snap/*/gaze-auth)    ;;
    *) echo "refusing to touch '$real': not a gaze clone directory." >&2
       echo "gaze only ever replaces its own clone, under:" >&2
       echo "  $CLONES/<browser>" >&2
       echo "  \$HOME/snap/<pkg>/.../gaze-auth" >&2
       exit 1 ;;
  esac
  printf '%s\n' "$real"
}


live_of(){ case "$1" in *PROFILES_INI) resolve_ini "$1" ;; *) echo "$1" ;; esac; }

# Pick the browser: $GAZE_BROWSER if set, else the first installed one that
# actually has a profile to clone, else the first installed one at all.
resolve(){
  local want="${GAZE_BROWSER:-}" row fallback="" bin live
  if [ -n "$want" ]; then
    row=$(row_for "$want")
    [ -z "$row" ] && { echo "unknown browser '$want'. try: gaze browsers" >&2; exit 2; }
    # Match the automatic path, which skips browsers that are not installed.
    bin=$(echo "$row" | cut -d'|' -f2)
    [ -x "$bin" ] || { echo "'$want' is not installed at $bin. try: gaze browsers" >&2; exit 2; }
    echo "$row"; return
  fi
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    bin=$(echo "$row" | cut -d'|' -f2)
    live=$(live_of "$(echo "$row" | cut -d'|' -f3)")
    [ -x "$bin" ] || continue
    [ -d "$live" ] && { echo "$row"; return; }
    [ -z "$fallback" ] && fallback="$row"
  done <<< "$BROWSERS"
  [ -n "$fallback" ] && { echo "$fallback"; return; }
  echo "no supported browser found. try: gaze browsers" >&2; exit 2
}

ROW=$(resolve) || exit $?
NAME=$(echo   "$ROW" | cut -d'|' -f1)
BIN=$(echo    "$ROW" | cut -d'|' -f2)
LIVE=$(live_of "$(echo "$ROW" | cut -d'|' -f3)")
AUTH="${GAZE_PROFILE:-$(echo "$ROW" | cut -d'|' -f4)}"
FAMILY=$(echo "$ROW" | cut -d'|' -f5)

# Chromium serves CDP on the debug port; Firefox serves WebDriver BiDi.
if [ "$FAMILY" = firefox ]; then
  up(){ curl -s --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1 \
        || ss -ltn 2>/dev/null | grep -q ":$PORT "; }
  BACKEND="$D/gaze-bidi.mjs"
else
  up(){ curl -s --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }
  BACKEND="$D/gaze.mjs"
fi

VERSION="1.0.0"

case "${1:-}" in
  version|--version|-v)
    rev=$(git -C "$D" rev-parse --short HEAD 2>/dev/null)
    echo "gaze $VERSION${rev:+ ($rev)}"
    exit 0 ;;

  update)
    # Updating is a git pull plus a dependency install. Nothing self-modifies,
    # nothing phones home, and nothing updates without you asking.
    if [ ! -d "$D/.git" ]; then
      echo "not a git checkout: update it however you installed it"; exit 1
    fi
    echo "current: $(git -C "$D" rev-parse --short HEAD)"
    git -C "$D" pull --ff-only || { echo "pull failed; resolve it by hand"; exit 1; }
    (cd "$D" && npm install --silent) || exit 1
    echo "now:     $(git -C "$D" rev-parse --short HEAD)"
    echo "run 'gaze doctor' to confirm, and 'gaze sync' if the profile layout changed."
    exit 0 ;;

  browsers)
    printf '%-15s %-9s %-40s %s\n' BROWSER DRIVER BINARY STATUS
    while IFS= read -r row; do
      [ -z "$row" ] && continue
      n=$(echo "$row"|cut -d'|' -f1); b=$(echo "$row"|cut -d'|' -f2)
      l=$(live_of "$(echo "$row"|cut -d'|' -f3)"); f=$(echo "$row"|cut -d'|' -f5)
      [ "$f" = firefox ] && drv=BiDi || drv=CDP
      if   [ ! -x "$b" ]; then s="not installed"
      elif [ ! -d "$l" ]; then s="installed, no profile yet"
      else s="ready"; fi
      [ "$n" = "$NAME" ] && s="$s  <- selected"
      printf '%-15s %-9s %-40s %s\n' "$n" "$drv" "$b" "$s"
    done <<< "$BROWSERS"
    echo
    echo "override with:  GAZE_BROWSER=<name> gaze ..."
    echo "Safari is unsupported: its remote protocol is WebKit-only and macOS-only." ;;

  start)
    up && { echo "already running on :$PORT"; exit 0; }
    # Headed by default, on purpose: you can watch it work and take over. Use
    # --headless (or GAZE_HEADLESS=1) for unattended runs with no display.
    HEADLESS=""
    case " $* " in *" --headless "*) HEADLESS=1 ;; esac
    [ -n "${GAZE_HEADLESS:-}" ] && HEADLESS=1
    # A missing clone launches a logged-OUT browser, which looks exactly like
    # "my logins broke". Fail loudly and say the fix instead.
    if [ ! -d "$AUTH" ]; then
      echo "no cloned profile for $NAME at $AUTH."
      echo "run:  gaze sync     # close $NAME first"
      exit 1
    fi

    # A browser that dies uncleanly leaves its profile lock behind. The next
    # launch then opens the debug port, fails the ProcessSingleton check a
    # moment later, and aborts -- so `start` polls the port, sees it, reports
    # "up", and the browser is gone seconds afterwards. That looks exactly like
    # a browser that randomly dies, and it is the single most confusing failure
    # this tool has. Clear the lock, but ONLY when nothing is using the profile.
    # Removing lock files is a delete on an operator-supplied path, so it gets
    # the same resolved check `sync` does. Without it, `start` would happily
    # remove lock files from any directory GAZE_PROFILE names.
    AUTH=$(assert_clone "$AUTH") || exit 1
    if [ "$FAMILY" = firefox ]; then inuse="--profile $AUTH"; else inuse="--user-data-dir=$AUTH"; fi
    if pgrep -f -- "$inuse" >/dev/null 2>&1; then
      echo "a browser is already using $AUTH."
      echo "close it, or run: gaze stop"
      exit 1
    fi
    stale=""
    if [ "$FAMILY" = firefox ]; then
      for f in lock .parentlock; do
        [ -e "$AUTH/$f" ] && { rm -f "$AUTH/$f" && stale="yes"; }
      done
    else
      for f in SingletonLock SingletonCookie SingletonSocket; do
        [ -e "$AUTH/$f" ] && { rm -f "$AUTH/$f" && stale="yes"; }
      done
    fi
    [ -n "$stale" ] && echo "cleared a stale profile lock from a previous run"

    mkdir -p "$D"
    if [ "$FAMILY" = firefox ]; then
      setsid "$BIN" --profile "$AUTH" --no-remote \
        --class gaze \
        ${HEADLESS:+--headless} \
        --remote-debugging-port="$PORT" \
        about:blank >"$D/browser.log" 2>&1 < /dev/null &
    else
      if [ ! -f "$AUTH/Default/Cookies" ]; then
        echo "cloned profile at $AUTH has no cookies. run: gaze sync"; exit 1
      fi
      # --class sets WM_CLASS, so the automation window gets its own taskbar
      # slot and icon instead of stacking under the everyday browser's.
      setsid "$BIN" --user-data-dir="$AUTH" \
        --class=gaze \
        ${HEADLESS:+--headless=new} \
        --remote-debugging-port="$PORT" --no-first-run --no-default-browser-check \
        --disable-blink-features=AutomationControlled --start-maximized \
        about:blank >"$D/browser.log" 2>&1 < /dev/null &
    fi
    for i in $(seq 1 25); do sleep 1; up && {
      echo "up on :$PORT ($NAME, $FAMILY${HEADLESS:+, headless})"; exit 0; }; done
    echo "failed to start; see $D/browser.log"; exit 1 ;;

  icon)
    # The window class alone separates it in the taskbar; a matching .desktop
    # entry is what gives that slot the gaze icon instead of a blank one.
    apps="$HOME/.local/share/applications"
    icons="$HOME/.local/share/icons/hicolor"
    mkdir -p "$apps" || { echo "cannot write $apps"; exit 1; }
    installed=0
    for sz in 16 32 48 64 128 256; do
      if [ -f "$D/docs/icon-$sz.png" ]; then
        mkdir -p "$icons/${sz}x${sz}/apps"
        cp "$D/docs/icon-$sz.png" "$icons/${sz}x${sz}/apps/gaze.png" && installed=$((installed+1))
      fi
    done
    [ "$installed" -gt 0 ] || { echo "no icons found under $D/docs"; exit 1; }
    cat > "$apps/gaze.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=gaze
GenericName=Automated browser
Comment=A real browser, already logged in
Icon=gaze
Exec=$SELF start
Terminal=false
Categories=Development;WebBrowser;
StartupWMClass=gaze
DESKTOP
    update-desktop-database "$apps" >/dev/null 2>&1
    gtk-update-icon-cache -f -t "$icons" >/dev/null 2>&1
    echo "installed $installed icon size(s) and $apps/gaze.desktop"
    echo "the window class only changes on a fresh launch: gaze stop && gaze start"
    ;;

  stop)   bash "$D/killauto.sh" "$PORT" ;;
  status) up && { curl -s "http://127.0.0.1:$PORT/json/version" | head -c 200; echo; } \
              || echo "not running" ;;

  sync)
    # Refresh stored logins from the everyday profile.
    # Close that browser first, or the copy may catch a half-written database.
    # Resolved, not lexical: see assert_clone. A typo like GAZE_PROFILE=$HOME,
    # or a traversal like $CLONES/../../.., must not reach `rm -rf`.
    # This runs FIRST, before the source profile is even looked for: refusing to
    # wipe a path that is not a gaze clone is an invariant, and it must not
    # depend on whether an everyday browser profile happens to exist. Ordering
    # it after the $LIVE check made the guard unreachable on any machine
    # without a browser installed, which is every clean CI runner.
    AUTH=$(assert_clone "$AUTH") || exit 1
    [ -d "$LIVE" ] || { echo "no $NAME profile at $LIVE"; exit 1; }
    bash "$D/killauto.sh" "$PORT" >/dev/null 2>&1; sleep 2
    rm -rf "$AUTH"   || { echo "could not clear $AUTH"; exit 1; }
    mkdir -p "$AUTH" || { echo "could not create $AUTH"; exit 1; }
    if [ "$FAMILY" = firefox ]; then
      # Firefox keeps sessions in a handful of files; copy the profile wholesale.
      cp -r "$LIVE/." "$AUTH/" 2>/dev/null
      rm -f "$AUTH/lock" "$AUTH/.parentlock" 2>/dev/null
    else
      mkdir -p "$AUTH/Default"
      cp "$LIVE/Local State" "$AUTH/" 2>/dev/null
      for f in Cookies "Login Data" "Web Data" Preferences "Secure Preferences" \
               "Local Storage" "Session Storage" Network; do
        cp -r "$LIVE/Default/$f" "$AUTH/Default/" 2>/dev/null
      done
    fi
    echo "synced $NAME logins ($(du -sh "$AUTH" | cut -f1)) -> $AUTH" ;;

  doctor)
    ok=0; bad=0
    # $1 label, $2 op, $3 operand, $4 hint. The operand is NEVER interpolated
    # into a string that gets eval'd: a profile path containing a quote used to
    # be enough to execute arbitrary commands here.
    chk(){
      local good=1
      case "$2" in
        -x)  [ -x "$3" ] || good=0 ;;
        -d)  [ -d "$3" ] || good=0 ;;
        -f)  [ -f "$3" ] || good=0 ;;
        -n)  [ -n "$3" ] || good=0 ;;
        cmd) command -v "$3" >/dev/null 2>&1 || good=0 ;;
        *)   good=0 ;;
      esac
      if [ "$good" = 1 ]; then echo "  ok    $1"; ok=$((ok+1))
      else echo "  FAIL  $1 -- $4"; bad=$((bad+1)); fi
    }
    echo "gaze doctor"
    echo "  browser: $NAME ($FAMILY, $([ "$FAMILY" = firefox ] && echo BiDi || echo CDP))"
    echo "  binary:  $BIN"
    chk "browser binary"         -x  "$BIN"                        "$NAME is not installed"
    chk "node"                   cmd node                           "node not on PATH"
    chk "backend present"        -f  "$BACKEND"                     "missing $BACKEND"
    [ "$FAMILY" = chromium ] && \
      chk "playwright installed" -d  "$D/node_modules/playwright"   "run: (cd $D && npm i)"
    chk "DISPLAY set ($DISPLAY)" -n  "$DISPLAY"                      "no X display; a visible browser cannot start"
    chk "everyday profile"       -d  "$LIVE"                         "cannot find $NAME to sync from"
    chk "cloned profile"         -d  "$AUTH"                         "run: gaze sync"
    if up; then echo "  ok    debug port :$PORT is live"; ok=$((ok+1))
    else echo "  --    not running (start it with: gaze start)"; fi
    if [ -d "$AUTH" ]; then
      age=$(( ( $(date +%s) - $(stat -c %Y "$AUTH") ) / 86400 ))
      echo "        profile snapshot is ${age}d old; re-run 'gaze sync' if sessions have rotated"
    fi
    echo "$ok ok, $bad failed"
    [ "$bad" -eq 0 ] ;;

  *) exec node "$BACKEND" "$@" ;;
esac
